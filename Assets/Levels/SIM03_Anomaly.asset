  m_Script: {fileID: 11500000, guid: f15209abd2e9b4147a4a9d9cfa84511e, type: 3}
  m_Name: SIM03_Anomaly
  m_EditorClassIdentifier: Assembly-CSharp::LevelData
  levelName: 'SIM 03: ANOMALY'
  isAnomaly: 1
  alienPrefabOverride: {fileID: 0}
  columns: 10
  rows: 4
  baseSpeed: 7
  maxSpeedMultiplier: 4.5
  speedUpExponent: 1.4
  baseFireRate: 2.1
  maxFireRate: 4
  aimedShotChance: 0.5
  alienBulletSpeed: 10.5
  darkBulletChance: 0.35
  briefingSystemLine: 'ALERT: Simulation 03 contains unverified data.'
  briefingDialogue:
  - speaker: 0
    text: 11S, wait. This one wasn't on the schedule.
  - speaker: 0
    text: The enemy data doesn't match any training record I have access to.
  - speaker: 0
    text: Pod, can you identify the source?
  - speaker: 1
    text: Negative. Access restricted.
  - speaker: 0
    text: ...Restricted? By who?
  - speaker: 1
    text: Information unavailable.
  - speaker: 0
    text: I've reported it. I'm told it's within parameters.
  - speaker: 0
    text: Just... stay sharp, 11S.
  debriefSystemLine: 'Analysis: Simulation 03 cleared. Anomalous data: purged.'
  debriefDialogue: []
  failureTitle: Simulation Integrity Compromised
  failureSystemLine: 'ALERT: Connection to unit interrupted.'
  failureDialogue:
  - speaker: 0
    text: 11S? 11S, respond--
  - speaker: 0
    text: ...Your vitals are stable. I'm pulling you out.
  - speaker: 1
    text: 'Report: Unit 11S data intact. Simulation will be reinitialized.'
  - speaker: 0
    text: Within parameters.
  - speaker: 0
    text: ...That's what they keep telling me.
  failureMenuLabel: '[ Reinitialize ]'
